# AirClaude — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then either export manually, or let python-dotenv load it automatically —
# both run_demo.py and run_model_eval.py load .env on startup.
# ─────────────────────────────────────────────────────────────


# ── Provider selection ─────────────────────────────────────────
# Which backend serves the Claude Developer Platform API. Same agent code,
# same tools, same messages — only the client changes.
#   direct  (default) — api.anthropic.com, needs ANTHROPIC_API_KEY below
#   bedrock            — AWS Bedrock, needs AWS credentials + AWS_REGION
#   vertex              — Google Vertex AI, needs GCP credentials + GOOGLE_CLOUD_PROJECT
CLAUDE_PROVIDER=direct


# ── REQUIRED for CLAUDE_PROVIDER=direct ──────────────────────────

# Your Anthropic API key.
# Get one at: https://console.anthropic.com/settings/keys
# Your key will start with: sk-ant-
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ── REQUIRED for CLAUDE_PROVIDER=bedrock ─────────────────────────
# Auth flows through the standard AWS credential chain — configure it with
# `aws configure`, an assumed role, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
# AWS_REGION=us-east-1


# ── REQUIRED for CLAUDE_PROVIDER=vertex ───────────────────────────
# Auth flows through Application Default Credentials —
# `gcloud auth application-default login`, or a service account key.
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_REGION=us-east5


# ── OPTIONAL — override defaults ──────────────────────────────

# Claude model id. Default: claude-sonnet-5
# claude-haiku-4-5-20251001 is a faster/cheaper option for the same loop.
# CLAUDE_MODEL=claude-sonnet-5

# Airflow home directory (default: ./airflow_home, created by run_airflow.sh)
# AIRFLOW_HOME=/path/to/your/airflow_home

# Repo root override. Only needed if you run the DAGs from a copy outside
# this repo — the DAGs and operator use it to find data/ and tools/.
# AIRCLAUDE_HOME=/path/to/airclaude
